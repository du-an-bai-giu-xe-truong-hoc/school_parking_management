# Database Configuration
DATABASE_URL=postgresql://parking_user:parking_password@localhost:5432/parking_db

# External API Configuration
DB_API_BASE_URL=http://127.0.0.1:5000/api

# Hardware Configuration
ARDUINO_PORT=COM3
BAUD_RATE=9600
ESP32_IP=192.168.81.61
ESP32_BASE_URL=http://192.168.81.61
ESP32_CAPTURE_URL=http://192.168.81.61/latest
ESP32_CAPTURE_PATH=/latest
ESP32_CAPTURE_TIMEOUT_SECONDS=4
ESP32_REFRESH_SECONDS=1.0

# GUI/Backend Camera Proxy (recommended)
FASTAPI_URL=http://localhost:8000
FASTAPI_PREFIX=/api
ESP32_USE_BACKEND_PROXY=1

# Application Configuration
DEBUG=true
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AI Module Configuration (Optional)
# YOLO_MODEL_PATH=models/yolov11.pt
# OCR_MODEL_PATH=models/vietocr